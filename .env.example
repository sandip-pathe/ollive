# Database
POSTGRES_USER=ollive
POSTGRES_PASSWORD=changeme
POSTGRES_DB=ollive_dev
DATABASE_URL=postgresql://ollive:changeme@postgres:5432/ollive_dev

# Redis
REDIS_URL=redis://redis:6379/0

# OpenAI
OPENAI_API_KEY=

# Auth
AUTH_BYPASS=true
AUTH_INVITE_CODE=dev
AUTH_SESSION_SECRET=dev-session-secret
MAX_CALLS_PER_USER=1000

# Optional collector token. Leave empty for local-only development.
# Set this in shared/self-hosted environments and send it as X-Ollive-Token.
OLLIVE_INGEST_TOKEN=

# Frontend
NEXT_PUBLIC_API_BASE=http://localhost:8001
NEXT_PUBLIC_AUTH_BYPASS=true

# App
API_PORT=8000

